diff --git a/kernel/feature/selinux_hide_compat.c b/kernel/feature/selinux_hide_compat.c
new file mode 100644
index 00000000..4a875968
--- /dev/null
+++ b/kernel/feature/selinux_hide_compat.c
@@ -0,0 +1,126 @@
+#include "selinux_hide.h"
+
+#include <linux/compiler.h>
+#include <linux/gfp.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <security.h>
+#include <ss/services.h>
+
+/*
+ * SukiSU's feature/selinux_hide.c is deliberately limited to 5.10+ because
+ * it walks struct selinux_policy and selinux_state.status_{lock,page}.
+ * None of that is needed by the three SUSFS hooks in this kernel tree:
+ * they only need a manager-controlled running flag, and the 5.4 SUSFS
+ * implementations in security/selinux/ss/services.c do the actual work.
+ *
+ * Keep the public feature contract on 5.4 too, so the manager can query and
+ * toggle KSU_FEATURE_SELINUX_HIDE instead of seeing it as unsupported.
+ */
+static DEFINE_MUTEX(ksu_selinux_hide_mutex);
+
+/* Default on to preserve the behaviour of the existing 5.4 SUSFS hooks. */
+bool ksu_selinux_hide_enabled __read_mostly = true;
+bool ksu_selinux_hide_running __read_mostly = true;
+
+static int selinux_hide_feature_get(u64 *value)
+{
+    *value = READ_ONCE(ksu_selinux_hide_enabled) ? 1 : 0;
+    return 0;
+}
+
+static int selinux_hide_feature_set(u64 value)
+{
+    bool enable = value != 0;
+
+    mutex_lock(&ksu_selinux_hide_mutex);
+    WRITE_ONCE(ksu_selinux_hide_enabled, enable);
+    WRITE_ONCE(ksu_selinux_hide_running, enable);
+    mutex_unlock(&ksu_selinux_hide_mutex);
+
+    pr_info("selinux_hide: 5.4 compat set enabled=%d running=%d\n",
+            enable, enable);
+    return 0;
+}
+
+static const struct ksu_feature_handler selinux_hide_handler = {
+    .feature_id = KSU_FEATURE_SELINUX_HIDE,
+    .name = "selinux_hide",
+    .get_handler = selinux_hide_feature_get,
+    .set_handler = selinux_hide_feature_set,
+};
+
+void __init ksu_selinux_hide_init(void)
+{
+    if (ksu_register_feature_handler(&selinux_hide_handler))
+        pr_err("selinux_hide: failed to register 5.4 compatibility handler\n");
+    else
+        pr_info("selinux_hide: registered 5.4 compatibility handler\n");
+}
+
+void __exit ksu_selinux_hide_exit(void)
+{
+    ksu_unregister_feature_handler(KSU_FEATURE_SELINUX_HIDE);
+}
+
+static struct page *ksu_selinux_hide_fake_status;
+
+struct page *ksu_selinux_hide_status_page(struct selinux_state *state)
+{
+    struct selinux_kernel_status *status;
+    struct page *fake;
+
+    if (!state || !state->ss)
+        return NULL;
+
+    /*
+     * Make sure the real status page exists before taking status_lock:
+     * selinux_kernel_status_page() takes the same lock itself.
+     */
+    if (!state->ss->status_page)
+        selinux_kernel_status_page(state);
+
+    mutex_lock(&state->ss->status_lock);
+    fake = ksu_selinux_hide_fake_status;
+    if (!fake && state->ss->status_page) {
+        status = page_address(state->ss->status_page);
+        if (status->enforcing) {
+            fake = alloc_page(GFP_KERNEL | __GFP_ZERO);
+            if (!fake) {
+                pr_err("selinux_hide: failed to allocate 5.4 fake status page\n");
+                goto out;
+            }
+            memcpy(page_address(fake), status, sizeof(*status));
+            ksu_selinux_hide_fake_status = fake;
+            pr_info("selinux_hide: initialized 5.4 fake status page\n");
+        }
+    }
+out:
+    fake = ksu_selinux_hide_fake_status;
+    mutex_unlock(&state->ss->status_lock);
+    return fake;
+}
+
+/*
+ * The 5.4 path has no backup policy. The fake status page must be captured
+ * before apply_kernelsu_rules() changes the real policyload/sequence, so
+ * the second-stage hook initializes it here. selinuxfs also initializes it
+ * lazily on first app open as a fallback.
+ */
+void ksu_selinux_hide_handle_second_stage(void)
+{
+    if (READ_ONCE(ksu_selinux_hide_running))
+        (void)ksu_selinux_hide_status_page(&selinux_state);
+}
+
+void ksu_selinux_hide_handle_post_fs_data(void)
+{
+    if (READ_ONCE(ksu_selinux_hide_running))
+        (void)ksu_selinux_hide_status_page(&selinux_state);
+}
+
+void ksu_selinux_hide_drop_backup_if_unused(void)
+{
+}
