                     if (curr_cs_ptr && *curr_cs_ptr) {
-                        (*curr_cs_ptr)->vdso_clock_mode =
+                        ksu_cs_vdso_clock_mode(*curr_cs_ptr) =
                             VDSO_CLOCKMODE_ARCHTIMER;
                     } else {
                         pr_warn("ksu: set_spoof_cpu failed to resolve 'curr_clocksource'\n");
