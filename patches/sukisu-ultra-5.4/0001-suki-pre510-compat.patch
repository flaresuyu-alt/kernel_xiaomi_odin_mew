diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index 3d5b86e..abba866 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -255,6 +255,16 @@ do_stop_machine:
 out_flush:
     smp_mb();
     reset_avc_cache();
+#ifdef CONFIG_KSU_SUSFS
+    /*
+     * The >= 5.10 path above refreshes the cached SUSFS SIDs right after
+     * swapping selinux_state.policy. On 5.4 the policy swap happens here
+     * instead, so this is the equivalent point: without it susfs_zygote_sid
+     * stays 0, ksu_handle_setresuid() never recognises zygote, and the
+     * manager process never receives its [ksu_driver] fd.
+     */
+    susfs_set_batch_sid();
+#endif
 #endif
