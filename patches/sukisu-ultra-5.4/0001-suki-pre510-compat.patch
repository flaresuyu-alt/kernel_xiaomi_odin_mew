diff --git a/kernel/extension/cpu_spoof.c b/kernel/extension/cpu_spoof.c
index 0007c2f..55a453b 100644
--- a/kernel/extension/cpu_spoof.c
+++ b/kernel/extension/cpu_spoof.c
@@ -21,6 +21,17 @@
 #include <linux/uaccess.h>
 #include <linux/version.h>
 
+/*
+ * struct clocksource gained a top-level vdso_clock_mode in 5.10. On 5.4 the
+ * same field lives in archdata.clock_mode, and arm64 always selects
+ * ARCH_CLOCKSOURCE_DATA, so the field is always present here.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#define ksu_cs_vdso_clock_mode(cs) ((cs)->vdso_clock_mode)
+#else
+#define ksu_cs_vdso_clock_mode(cs) ((cs)->archdata.clock_mode)
+#endif
+
 
 #if defined(CONFIG_ARM64) || defined(__aarch64__)
 #include <asm/cpu.h>
@@ -170,7 +181,7 @@ static int set_spoof_cpu(const struct ksu_set_spoof_cpu_cmd *cmd)
                         (struct clocksource **)find_kernel_symbol_exact(
